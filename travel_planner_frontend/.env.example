# Copy this file to .env in the project root (same folder as package.json)
# Variables must be prefixed with REACT_APP_ to be available in the app.

# OpenTripMap API (recommended/required for attractions)
REACT_APP_OPENTRIPMAP_API_KEY=

# OpenRouteService API (optional; required for real road routing)
REACT_APP_ORS_API_KEY=

# Nominatim User-Agent (recommended to respect OSM policy)
REACT_APP_NOMINATIM_UA="OceanTrip Planner (contact: you@example.com)"
