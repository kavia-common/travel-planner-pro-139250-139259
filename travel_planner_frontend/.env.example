# OceanTrip Planner - Environment Variables
# Copy this file to .env and fill in keys as needed.

# Optional but recommended: Respect Nominatim policy by setting a descriptive UA
REACT_APP_NOMINATIM_UA=OceanTripPlanner/1.0 (contact: youremail@example.com)

# OpenTripMap API key (required for attractions)
REACT_APP_OPENTRIPMAP_API_KEY=YOUR_OPENTRIPMAP_API_KEY

# OpenRouteService API key (optional; if unset, straight-line fallback is used)
REACT_APP_ORS_API_KEY=YOUR_ORS_API_KEY
