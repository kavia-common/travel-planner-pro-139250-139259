# Copy this file to .env in the same directory (project root) and fill in your keys.
# IMPORTANT: With Create React App, only variables prefixed with REACT_APP_ are exposed to the browser.

# OpenTripMap (Attractions)
REACT_APP_OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# OpenRouteService (Routing)
REACT_APP_ORS_API_KEY=your_openrouteservice_key_here

# Nominatim (Geocoding) - Recommended: set a meaningful UA with contact info
REACT_APP_NOMINATIM_UA="OceanTrip Planner (contact: you@example.com)"
