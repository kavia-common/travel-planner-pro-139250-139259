# Environment variables for OceanTrip Planner (React)
# Copy this file to ".env" in the same folder as package.json and fill the values as needed.
# After changes, restart the dev server.

# OpenTripMap API key (FREE TIER)
# Required for reliable attraction search. Sign up free: https://opentripmap.io/
REACT_APP_OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# OpenRouteService API key (FREE TIER)
# Optional for basic use; required for real driving route geometry.
# If not set, the app draws a simple straight polyline between stops.
# Sign up: https://openrouteservice.org/
REACT_APP_ORS_API_KEY=your_ors_key_here

# Nominatim User-Agent override
# Strongly recommended to comply with policy and avoid blocks. Include contact info or URL.
# Example: "OceanTrip Planner (contact: me@example.com)"
REACT_APP_NOMINATIM_UA=OceanTrip Planner (contact: your_email_or_url)
