# Environment variables for OceanTrip Planner (React)
# Copy this file to ".env" in the same folder as package.json and fill in values as needed.
# Note: CRA loads env vars at startup; after editing .env, restart the dev server.

# OpenTripMap API key (recommended/required for reliable attraction results)
REACT_APP_OPENTRIPMAP_API_KEY=your_opentripmap_key_here

# OpenRouteService API key (optional; required for real road routing)
REACT_APP_ORS_API_KEY=your_openrouteservice_key_here

# Nominatim User-Agent (recommended to comply with policy; include contact info)
REACT_APP_NOMINATIM_UA="OceanTrip Planner (contact: you@example.com)"
