# Example environment variables for OceanTrip Planner (Create React App)
# Copy to .env and fill in values as needed.

# Respect Nominatim policy: provide a descriptive User-Agent string or contact URL/email.
REACT_APP_NOMINATIM_UA="OceanTripPlanner/1.0 (https://your-site.example; contact@example.com)"

# OpenTripMap API key (recommended/required for attractions)
REACT_APP_OPENTRIPMAP_API_KEY="your-opentripmap-key"

# OpenRouteService API key (optional; enables real road routing)
REACT_APP_ORS_API_KEY="your-ors-key"
