# Optional API keys for improved functionality and higher rate limits
# Request these values from the user/environment and copy into .env (do not commit real secrets)

# OpenTripMap (POI search). Optional; without a key, stricter rate limits may apply.
REACT_APP_OPENTRIPMAP_API_KEY=

# OpenRouteService (routing). Optional; without a key the app will draw a straight line between stops.
REACT_APP_ORS_API_KEY=
